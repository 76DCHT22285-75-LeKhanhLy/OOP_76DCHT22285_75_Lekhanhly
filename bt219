#include <iostream>
#include <cmath>
using namespace std;

class SP1
{
protected:
    float phanThuc;
    float phanAo;

public:
    // Hàm tạo không đối
    SP1()
    {
        phanThuc = 0;
        phanAo = 0;
    }

    // Hàm tạo có đối
    SP1(float thuc, float ao)
    {
        phanThuc = thuc;
        phanAo = ao;
    }

    void nhap()
    {
        cout << "Nhap phan thuc: ";
        cin >> phanThuc;

        cout << "Nhap phan ao: ";
        cin >> phanAo;
    }

    void xuat()
    {
        cout << phanThuc;

        if (phanAo >= 0)
            cout << " + " << phanAo << "i";
        else
            cout << " - " << -phanAo << "i";
    }
    float module()
    {
        return sqrt(phanThuc * phanThuc +
                    phanAo * phanAo);
    }
};

class SP2 : public SP1
{
public:
    // Hàm tạo không đối
    SP2() : SP1()
    {
    }

    // Hàm tạo có đối
    SP2(float thuc, float ao) : SP1(thuc, ao)
    {
    }

    // Nạp chồng toán tử =
    SP2& operator=(const SP2& sp)
    {
        phanThuc = sp.phanThuc;
        phanAo = sp.phanAo;
        return *this;
    }
    bool operator>(const SP2& sp)
    {
        return this->module() > sp.module();
    }
};

int main()
{
    SP2 ds[10];
    int n;
    do
    {
        cout << "Nhap so luong so phuc (1-10): ";
        cin >> n;
    }
    while (n < 1 || n > 10);

    cout << "nhap damh sach so phuc";

    for (int i = 0; i < n; i++)
    {
        cout << "So phuc thu " << i + 1 << ":\n";
        ds[i].nhap();
    }

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (ds[j] > ds[i])
            {
                SP2 temp;

                temp = ds[i];
                ds[i] = ds[j];
                ds[j] = temp;
            }
        }
    }

    cout << "danh sach sau khi xap xep";
    for (int i = 0; i < n; i++)
    {
        cout << "\nSo phuc " << i + 1 << ": ";
        ds[i].xuat();

        cout << "    | Module = "
             << ds[i].module();
    }
    return 0;
}
